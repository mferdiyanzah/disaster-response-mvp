[Unit]
Description=Disaster Response Dashboard (Streamlit)
After=network.target

[Service]
Type=simple
User=ferdiyanzah
WorkingDirectory=/home/ferdiyanzah/Engineering/Projects/disaster-response-mvp
EnvironmentFile=/home/ferdiyanzah/Engineering/Projects/disaster-response-mvp/.env
ExecStart=/home/ferdiyanzah/Engineering/Projects/disaster-response-mvp/venv/bin/streamlit run dashboard/app.py --server.port=8501 --server.address=0.0.0.0 --server.headless=true --browser.gatherUsageStats=false
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
