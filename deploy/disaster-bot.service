[Unit]
Description=Disaster Response Telegram Bot
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/disaster-response-mvp
EnvironmentFile=/home/ubuntu/disaster-response-mvp/.env
ExecStart=/home/ubuntu/disaster-response-mvp/venv/bin/python -m bot.main_production
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
