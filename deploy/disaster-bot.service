[Unit]
Description=Disaster Response Telegram Bot
After=network.target

[Service]
Type=simple
User=ferdiyanzah
WorkingDirectory=/home/ferdiyanzah/Engineering/Projects/disaster-response-mvp
EnvironmentFile=/home/ferdiyanzah/Engineering/Projects/disaster-response-mvp/.env
ExecStart=/home/ferdiyanzah/Engineering/Projects/disaster-response-mvp/venv/bin/python -m bot.main_production
Restart=always
RestartSec=5

[Install]
